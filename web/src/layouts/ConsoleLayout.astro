---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "ChatBotAws · Consola local" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
